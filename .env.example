# Copy this file to .env and fill in real values. .env is gitignored — never commit real values.

# From your Supabase project: Settings > API Keys.
# Both are safe to expose in client-side code — the anon/publishable key is
# meant to be public (Supabase's own access rules protect it, not secrecy).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google sign-in no longer needs a key here — the OAuth Client ID and Secret
# are configured directly in the Supabase dashboard (Authentication > Providers
# > Google), not in this app's code or environment variables.
