# Copy this file to .env and fill in real values. .env is gitignored — never commit real values.

# Google OAuth "Web application" Client ID from https://console.cloud.google.com
# (APIs & Services > Credentials). This is a public identifier, safe to expose in
# client-side code — it is NOT the same as a Client Secret, which must never be here.
# Leave unset to skip the Google button and fall back to the manual name/workspace form.
VITE_GOOGLE_CLIENT_ID=
